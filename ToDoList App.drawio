  <diagram id="T38QCVfmlPrMEekOZIRJ" name="مشاكل الكود اللي بكتبه">
    <mxGraphModel dx="1720" dy="439" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tQVoiNG--hJBkWEdkKXM-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="1120" width="810" x="-140" y="90" as="geometry" />
        </mxCell>
        <mxCell id="tQVoiNG--hJBkWEdkKXM-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;direction: rtl;&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;فيه كود مكتوب بشكل &lt;b data--h-bstatus=&quot;0OBSERVED&quot;&gt;جامد &lt;/b&gt;&lt;b data--h-bstatus=&quot;0OBSERVED&quot;&gt;hardcode &lt;/b&gt;يعني التعليمات مكتوبة بشكل جامد. لما بدي آجي أغير لازم أضيف بشكل يدوي على الكود وهذا الإشي سلبي عشان بتطلب منا نضل نروح نغير بجزئيات من الكود اللي ممكن يتسبب فيه مشاكل أخرى بالكود&lt;br data--h-bstatus=&quot;0OBSERVED&quot;&gt;وبرضه مش عملي عشان كل ما البرنامج يطلع بأشياء تعديلات جديدة، المطورين بروحوا بصيروا يضيفوا فيها بشكل يدوي، واحنا بدنا نكتب كود بحيث يجري عليه تعديلات بالحد الأدنى. بدنا قدر المستطاع ما نضطر نرجع نعدل&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="320" x="330" y="110" as="geometry" />
        </mxCell>
        <mxCell id="tQVoiNG--hJBkWEdkKXM-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;direction: rtl;&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;عندي مشكلة في &lt;b data--h-bstatus=&quot;0OBSERVED&quot;&gt;معالجة الأخطاء أو ال Error Handling&lt;/b&gt;، هيني قاعد بستخدمهم بس لازم أقرأ وأتزود بمعرفة عنهم وأخصصلهم وقت&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="320" x="320" y="330" as="geometry" />
        </mxCell>
        <mxCell id="tQVoiNG--hJBkWEdkKXM-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;direction: rtl;&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;عندي مشكلة في &lt;b&gt;هياكل البيانات&lt;/b&gt;، لازم أكتسب معرفة وتجربة عملية معاهم، وأعرف إيجابيات وسلبيات ومتى نستخدم كل واحد عشان أكتب كود فعال بستخدم الموارد بأكبر فاعلية ممكنة.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="320" x="340" y="240" as="geometry" />
        </mxCell>
        <mxCell id="tQVoiNG--hJBkWEdkKXM-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;direction: rtl;&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;المشكلة العامة إنه فيه جزئيات بالبرمجة لازم أتزود فيها من المعرفة والتجربة والممارسة عشان أعرف أستخدمها وأنا أبرمج&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="320" x="160" y="10" as="geometry" />
        </mxCell>
        <mxCell id="InikXSPS4y2FAqP-0wjr-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;direction: rtl;&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;لازم أجمع معرفة عن الأماكن اللي بقدر فيها أخزن البيانت(أشهر الأماكن) وكيف أستخدمها جوا البرنامج، ويصير عندي فيها تجربة كويسة كثير وممارسة&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="320" x="-80" y="120" as="geometry" />
        </mxCell>
        <mxCell id="InikXSPS4y2FAqP-0wjr-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="لازم يكون عندي معرفة بتاريخ البرمجة، وكيف البرنامج عندي بشتغل، هذا الشيء لازم أقرأ عنه" vertex="1">
          <mxGeometry height="70" width="320" x="-80" y="220" as="geometry" />
        </mxCell>
        <mxCell id="sUnwzW1NCYzHd75fzQbK-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;direction: rtl;&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;لازم يكون فيه توثيق يشرح كل دالة method شو بتعمل وكل class شو وظيفته: أظن هيك بصير تكبير البرنامج وصيانته أسهل بكثير(ناقصني قراءة برضه) عشان أشوف الحلول الموجودة لهي القصص المختلفة. عندي فكرة، لو كل ملف بالكلاس اللي فيه بالدوال نعمل توثيق وهكذا وكل مجلد لبين ما نغطي النظام كامل.&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="320" x="-80" y="320" as="geometry" />
        </mxCell>
        <mxCell id="GQfX6cZzQtdgtpE_iPQW-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;rounded=0;" value="لازم ألعب بالمسامير والبراغي كثير دائما، وكمل قراءة وتعلم مش مشكلة" vertex="1">
          <mxGeometry height="70" width="320" x="-70" y="390" as="geometry" />
        </mxCell>
        <mxCell id="CCElrKnKvkefvX1i1Yrs-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;direction: rtl;&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;اليوم&amp;nbsp; فيه Exception صار و ال try-except ما مسكوه، عشان اسم الكلاس كان يشبه اسم الملف. كيف بقدر أمسك كل ال exceptions اللي ممكن يصيروا&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="320" x="-70" y="480" as="geometry" />
        </mxCell>
        <mxCell id="CCElrKnKvkefvX1i1Yrs-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;rounded=0;" value="الأدوات البرمجية اللي بشتغل معاها لازم أتعلمها: زي التيرمنال والكمبيوتر وقطعه، ولغات البرمجة وقواعد البيانات" vertex="1">
          <mxGeometry height="70" width="320" x="340" y="585" as="geometry" />
        </mxCell>
        <mxCell id="KpaFdpvbAxy6YiGfMmlR-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;direction: rtl;&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;لازم أعمل قائمة فيها كل العمليات اللي عملتها على الكود أقدر أراجعها، أظن هذا هو دور ال commit بال git لازم أحاول أتعلمه وأزبطه&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="320" x="320" y="490" as="geometry" />
        </mxCell>
        <mxCell id="zgHsDGa4C4tI87_ZIYLw-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;direction: rtl;&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;أنا شغال بعشوائية لازم يكون عندي منهجية شغال عليها، مش بس أبدا أعمل عمليات هيك. لازم مثلا أبدأ Agile أصير أعمل Sprints وشوي شوي وهيك بتصير شغلة الدوبامين هيتس اللي حكينا عنها&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="320" x="-50" y="585" as="geometry" />
        </mxCell>
        <mxCell id="Trih2JloYwRtyxXmoTMc-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;direction: rtl;&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;كيف أفصل بين العمليات اللي بعملها العميل واللي بعملها المدير ال Admin&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="320" x="330" y="680" as="geometry" />
        </mxCell>
        <mxCell id="tFG4NnazKuS5i6z_lI4R-1" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="236" width="390.34" x="-85.17000000000003" y="680" as="geometry" />
        </mxCell>
        <mxCell id="tFG4NnazKuS5i6z_lI4R-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;direction: rtl;&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;بالنسبة للصورة: طيب أنا عندي Module/File اسمه TasksList.py حاطط جواته الكلاس/النموذج اللي اسمه TasksListc.py طب هسا كيف أمثلها على ال UML Class Diagram&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="320" x="-50" y="930" as="geometry" />
        </mxCell>
        <mxCell id="FL9hRSHyt_PN5swMgxSS-1" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="56" width="780" x="-140" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="FL9hRSHyt_PN5swMgxSS-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;direction: rtl;&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;استخدام ال Self وبحالتي أنا بقدر أشيلهم من الموديولز؟&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="320" x="94" y="1106" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
