        <mxCell id="FzxrbVdsOaXDZtc13aV4-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;direction: rtl;&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;&lt;span style=&quot;font-size: 21px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; data--h-bstatus=&quot;0OBSERVED&quot;&gt;تطبيق ToDoList هو برنامج بسمح للمستخدم إنه ينشئ قوائم مهام لازم يعملها. المستخدم بقدر يحدد تاريخ(شهر،يوم،سنة) القائمة، بقدر يضيف مهام على القائمة، فيه ممكن تكون مزايا، بقدر يحدد أولويات المهام&lt;br data--h-bstatus=&quot;0OBSERVED&quot;&gt;الهدف: جمع جميع المهمات التي يريد المستخدم تنفيذها في مكان واحد لتسهيل إدارتها وتجنب مشاكل شائعة كتنفيذ مهام ذات أولوية قليلة أولا أو نسيان تنفيذ مهمة ما، ...&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="364" x="50" y="-260" as="geometry" />
        </mxCell>
